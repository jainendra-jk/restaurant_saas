# =============================================================================
# FastAPI service (apps/api) — run: pnpm dev:api
# =============================================================================
# Base URL for admin dashboard to call the API (browser).
# Admin Vite uses envDir = monorepo root, so this file is enough when copied to .env
VITE_API_BASE_URL=http://localhost:8000
# Comma-separated origins for CORS (optional; defaults to common Vite ports)
API_CORS_ORIGINS=
API_PORT=8000
# Server-side Supabase (never expose service role to the browser).
# URL: optional if VITE_SUPABASE_URL is set (API reads either).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# API keys (server-side only — do not use VITE_ prefix)
# Copy to .env and fill in your keys. Never commit .env.
# =============================================================================
GOOGLE_API_KEY=

# =============================================================================
# Supabase (create project at https://supabase.com)
# =============================================================================
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# QR links (customer app base URL)
# CUSTOMER_APP_ORIGIN = same value as VITE_CUSTOMER_APP_ORIGIN (Python reads this)
# Slug rules: lowercase, spaces -> hyphens, strip non-alphanumeric except hyphen
# =============================================================================
CUSTOMER_APP_ORIGIN=https://order.example.com
VITE_CUSTOMER_APP_ORIGIN=https://order.example.com

# Onboarding flow: redirect after signup
VITE_ADMIN_DASHBOARD_ORIGIN=https://admin.example.com

# QR service (Python): restaurant display name for slug + metadata (also used by ai_service)
RESTAURANT_NAME=Tasty Bites Cafe
TABLE_COUNT=10
