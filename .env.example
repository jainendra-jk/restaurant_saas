# =============================================================================
# FastAPI service (apps/api) — run: pnpm dev:api
# =============================================================================
# Base URL for apps/api (browser). Used by admin dashboard, onboarding flow (PDF + QR).
# Admin Vite uses envDir = monorepo root. For local dev URLs see README (fixed ports per app).
VITE_API_BASE_URL=http://localhost:8000
# Comma-separated origins for CORS (optional; defaults to common Vite ports)
API_CORS_ORIGINS=
API_PORT=8000
# Menu extraction tuning (optional)
MENU_EXTRACT_MAX_CONCURRENT_PAGES=3
MENU_EXTRACT_RETRY_COUNT=2
MENU_EXTRACT_RETRY_BACKOFF_SECONDS=0.75
# Max pages to process from uploaded PDF (increase for very large menus)
MENU_EXTRACT_MAX_PAGES=60
# Page cap behavior:
# - truncate: process first N pages and include skipped counts in extract metadata/logs
# - error: fail request if PDF exceeds MENU_EXTRACT_MAX_PAGES
MENU_EXTRACT_PAGE_CAP_MODE=truncate
MENU_EXTRACT_PDF_DPI=150
# Server-side Supabase (never expose service role to the browser).
# URL: optional if VITE_SUPABASE_URL is set (API reads either).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# API keys (server-side only — do not use VITE_ prefix)
# Copy to .env and fill in your keys. Never commit .env.
# =============================================================================
GOOGLE_API_KEY=

# =============================================================================
# Supabase (create project at https://supabase.com)
# =============================================================================
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Forgot password (marketing + admin): enable 6-digit OTP in Supabase → Authentication → Email Templates → Reset password (include {{ .Token }} / OTP in the body). See docs/APP_FUNCTIONING.md.

# =============================================================================
# QR links (customer app base URL)
# CUSTOMER_APP_ORIGIN = same value as VITE_CUSTOMER_APP_ORIGIN (Python reads this)
# Slug rules: lowercase, spaces -> hyphens, strip non-alphanumeric except hyphen
# =============================================================================
# QR / customer app base URL (must match deployed customer app). Python API uses CUSTOMER_APP_ORIGIN too.
CUSTOMER_APP_ORIGIN=https://order.example.com
VITE_CUSTOMER_APP_ORIGIN=https://order.example.com

# Onboarding “Go to Dashboard” after signup
VITE_ADMIN_DASHBOARD_ORIGIN=https://admin.example.com
# Marketing-site cross-app routing (read by apps/Website Design final via envDir = monorepo root)
VITE_ONBOARDING_FLOW_ORIGIN=https://onboarding.example.com
# Optional explicit marketing origin for admin auth redirects (falls back to VITE_WEBSITE_ORIGIN)
VITE_MARKETING_ORIGIN=https://www.example.com
# Used by onboarding to redirect users without a subscription back to checkout (must match deployed marketing app URL)
# Must match Supabase Auth “Site URL” and the host you add to “Redirect URLs” for OAuth (see docs/DEPLOY_VERIFY.md).
VITE_WEBSITE_ORIGIN=https://www.example.com
# Display price string for “Website plan” on marketing-site dashboard products page (Website Design final)
VITE_WEBSITE_PLAN_PRICE=$19
VITE_WEDDING_PLATE_DASHBOARD_ORIGIN=https://wedding.example.com

# --- Local dev (fixed Vite ports: admin 5174, customer 5175, onboarding 5176) ---
# CUSTOMER_APP_ORIGIN=http://localhost:5175
# VITE_CUSTOMER_APP_ORIGIN=http://localhost:5175
# VITE_ADMIN_DASHBOARD_ORIGIN=http://localhost:5174
# VITE_ONBOARDING_FLOW_ORIGIN=http://localhost:5176
# VITE_MARKETING_ORIGIN=http://localhost:5173
# VITE_WEBSITE_ORIGIN=http://localhost:5173
# VITE_WEDDING_PLATE_DASHBOARD_ORIGIN=http://localhost:5177

# =============================================================================
# SaaS billing — Stripe only (Supabase Edge Functions — `supabase secrets set`, not VITE_)
# Deploy: supabase functions deploy create-billing-checkout stripe-webhook
# Marketing checkout: supabase.functions.invoke('create-billing-checkout', { body: { plan } })
# Stripe webhook URL: https://<project-ref>.supabase.co/functions/v1/stripe-webhook
# =============================================================================
# MARKETING_SITE_URL=https://www.example.com
# ONBOARDING_SITE_URL=https://onboarding.example.com
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are usually auto-injected in Edge Functions)
#
# --- Future: SaaS billing via Razorpay (not wired in checkout today) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_STARTER=plan_...
# RAZORPAY_PLAN_PROFESSIONAL=plan_...
# Deploy when implemented: supabase functions deploy razorpay-webhook

# Supabase Dashboard → Database → Replication: enable Realtime for menu_categories and menu_items
# if you want the customer ordering app to refresh the menu without reload.

# QR service (Python): restaurant display name for slug + metadata (also used by ai_service)
RESTAURANT_NAME=Tasty Bites Cafe
TABLE_COUNT=10
